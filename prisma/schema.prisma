// grantry — Prisma schema
// PostgreSQL (Railway). Replaces the SQLite schema from the Python prototype.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- User auth (better-auth compatible) ----------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user") // "user" | "admin"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  agents        Agent[]
  tenants       Tenant[]
  connections   Connection[]
  workspaceProviders WorkspaceProvider[]
  providerCredentials ProviderCredential[]
  customProviders   CustomProvider[]
  connectionGrants AgentConnectionGrant[]
  roles         Role[]
  auditLogs     AuditLog[]
  oauthApplications OauthApplication[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents     OauthConsent[]
  oauthAgentGrants  OauthAgentGrant[]
  workspaceMembers  WorkspaceMember[]
  agentAssignments  AgentAssignment[]
  mcpTokens         UserMcpToken[]
  adminApiKeys      AdminApiKey[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------- Agent / tenant / connection grants (the "grantry" part) ----------

// A tenant is a role/workflow permission bundle inside a workspace. `slug` is
// the immutable wire key — it is what agents send as `scope` in tools/call and
// in the X-Grantry-Scope header, so it must never change after creation.
// Workspace is the customer/data boundary; tenant is the execution context.
model Tenant {
  id          String   @id @default(cuid())
  slug        String   // immutable wire key, e.g. "grantry-dev"
  displayName String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String?  // null only before workspace backfill
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections Connection[]
  // The slug is the wire key agents send as `scope`, and the runtime resolves
  // it per workspace — so uniqueness is per (workspaceId, slug), NOT per
  // owner. A per-owner unique here once made ensureTenant silently reuse a
  // same-slug tenant from a *different* workspace of the same user, leaking
  // new connections into the wrong workspace.
  @@unique([workspaceId, slug])
  @@index([ownerId])
  @@map("tenant")
}

model Agent {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  // Per-agent runbook (Markdown, e.g. a Claude Code SKILL.md). Distinct in
  // nature from the platform skill (docs/skill.md): that explains how to
  // operate grantry, this defines what THIS agent does. Served over MCP via
  // grantry/get_runbook so an agent can be shared by its MCP token alone.
  // Holds the SKILL.md text: either the whole runbook (single-file case) or,
  // when a .skill bundle is uploaded, the extracted SKILL.md for preview.
  runbookMarkdown String?
  // Full skill bundle (a .skill / .zip: SKILL.md + references/ + scripts/ +
  // assets/). Stored as JSON {filename, files:[{path, size, content_b64}]} so
  // reads need no unzip lib. Served over MCP as a manifest (grantry/get_runbook)
  // plus per-file fetch (grantry/get_runbook_file); the recipient reconstructs
  // the skill directory. Null when only a single-file SKILL.md was provided.
  runbookBundle String?
  hashedToken   String   // sha256 of the high-entropy agent token (gn_agt_...)
  tokenPrefix   String   // first 12 chars of plaintext (for UI display)
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(true)
  fullScopeManager Boolean @default(false)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaceId   String?  // null only before workspace backfill
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Legacy migration relation. Runtime authorization uses connectionGrants.
  roles         AgentRole[]
  connectionGrants AgentConnectionGrant[]
  auditLogs     AuditLog[]
  oauthAgentGrants OauthAgentGrant[]
  assignments   AgentAssignment[]
  stagedFiles   StagedFile[]
  uploadTickets UploadTicket[]

  @@index([workspaceId])
  @@map("agent")
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  allowedTools  String   // legacy migration data; runtime ignores this
  allowedScopes String   // legacy migration data; runtime ignores this
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId   String?  // null only before workspace backfill
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agents        AgentRole[]

  @@index([workspaceId])
  @@map("role")
}

model AgentRole {
  agentId String
  roleId  String
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([agentId, roleId])
  @@map("agent_role")
}

model AgentConnectionGrant {
  agentId      String
  connectionId String
  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  agent        Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([agentId, connectionId])
  @@index([connectionId])
  @@index([createdById])
  @@map("agent_connection_grant")
}

model Connection {
  id                  String   @id @default(cuid())
  provider            String   // "github" | "cloudflare" | "clarity" | "notion" | "google_drive" | "google_gsc" | "google_analytics" | "google_ads" | "yahoo_ads" | "gmail" | "hubspot" | "attio" | "reddit" | "x"
  authType            String   @default("pat") // "pat" | "oauth" | "private_app" | "service_account"
  label               String
  scope               String   @default("") // denormalized tenant slug (immutable, always equals tenant.slug); "" = legacy unscoped
  tenantId            String?  // null only for legacy unscoped (scope="") connections
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId             String
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  encryptedCredential String   // Fernet-encrypted PAT/OAuth token
  credentialId        String?
  credential          ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  // Which workspace OAuth app minted these tokens (ProviderCredential row with
  // authType="oauth_app"). Refresh tokens are bound to the client that issued
  // them, so refreshing with a different app fails — recording the app makes
  // that mismatch explicit instead of a silent invalid_grant. Null for tokens
  // minted before this column existed, or from an env-level OAuth client.
  oauthAppCredentialId String?
  encryptedServerCredential String? // encrypted provider-level secret, e.g. Google Ads developer token
  credentialMetadata  String   @default("{}") // JSON: observed provider scopes/capabilities, never raw token
  // Non-secret per-connection variables substituted into the provider's
  // templated baseUrl/path (e.g. {"teamId":"Y309..."} for a tenant-scoped API
  // whose key is bound to one team). Never holds credentials.
  connectionConfig    String   @default("{}") // JSON: {varName: value} for {var} template expansion
  credentialValidatedAt DateTime?
  healthStatusSnapshot String?
  healthCheckedAtSnapshot DateTime?
  // OAuth-specific (null for PAT-only providers like notion)
  refreshToken        String?  // also Fernet-encrypted
  accessTokenExpiresAt DateTime?
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspaceId         String?  // null only before workspace backfill
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentGrants         AgentConnectionGrant[]
  auditLogs           AuditLog[]

  @@index([provider, scope])
  @@index([ownerId, provider, scope])
  @@index([ownerId])
  @@index([tenantId])
  @@index([workspaceId])
  @@index([credentialId])
  @@index([oauthAppCredentialId])
  @@map("connection")
}

// Workspace-owned provider credential. Tenant-scoped Connection rows may
// reference the same credential while keeping AgentConnectionGrant scoped to a
// specific tenant connection.
model ProviderCredential {
  id                  String   @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId             String
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider            String
  authType            String
  label               String
  encryptedCredential String
  encryptedServerCredential String?
  credentialMetadata  String   @default("{}")
  credentialValidatedAt DateTime?
  healthStatus        String?
  healthCheckedAt     DateTime?
  healthLastOkAt      DateTime?
  healthErrorCode     String?
  healthErrorMessage  String?
  healthMissingScopes String   @default("[]")
  refreshToken        String?
  accessTokenExpiresAt DateTime?
  // For authType="oauth" rows: which workspace OAuth app (authType="oauth_app"
  // row) minted this credential, so refresh uses that same client. Always null
  // on the oauth_app rows themselves.
  oauthAppCredentialId String?
  enabled             Boolean  @default(true)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  connections         Connection[]

  @@index([workspaceId, provider, authType])
  @@index([ownerId, provider, authType])
  @@index([oauthAppCredentialId])
  @@map("provider_credential")
}

model CustomProvider {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key                 String
  label               String
  helpText            String
  tokenUrl            String?
  baseUrl             String
  authScheme          String    @default("bearer")
  apiKeyHeader        String?
  allowedPathPrefixes String    @default("[\"/\"]")
  blockedPathPrefixes String    @default("[]")
  defaultMethods      String    @default("[\"GET\"]")
  smokeTests          String    @default("[]")
  operations          String    @default("[]")
  enabled             Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([workspaceId, key])
  @@index([ownerId])
  @@index([workspaceId, enabled])
  @@map("custom_provider")
}

// ---------- grantry admin API keys ----------
// grantry treats itself as just another provider: a human mints a gn_adm_ API
// key on the dashboard (/api-keys), pastes it into a normal connection
// (provider="grantry"), and grants that connection to an agent like any SaaS
// credential. The key is the admin capability — issuance is dashboard-only
// (a key can never mint another key), and agents never see the plaintext, so
// admin access cannot self-replicate. Rotating/disabling the key kills every
// connection that holds it.
model AdminApiKey {
  id          String   @id @default(cuid())
  label       String
  hashedKey   String   @unique // sha256 of the plaintext gn_adm_ key
  keyPrefix   String   // first 15 chars for display
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([ownerId])
  @@map("admin_api_key")
}

// ---------- OAuth state (CSRF protection during OAuth callback) ----------

model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  provider     String
  codeVerifier String?  // for PKCE
  payload      String?  // wizard metadata (tenant, agent, OAuth queue)
  redirectTo   String?  // URL to send user after success
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([state])
  @@map("oauth_state")
}

// ---------- Audit log ----------

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?  // null = anonymous (e.g. agent-only call)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentId         String?
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  connectionId    String?
  connection      Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider        String   // "github" | "notion" | ...
  tool            String   // "github/list_repos"
  scope           String   @default("")
  status          String   // "ok" | "denied" | "error"
  errorMessage    String?
  requestArgs     String?
  responseSummary String?
  durationMs      Int?
  ipAddress       String?
  userAgent       String?
  // Delegation (docs/agent-orchestration.md): when this call ran via
  // grantry/delegate, `agentId` is the executing agent and these record the
  // router that delegated it + the grant that authorized this single call.
  delegatedById   String?
  delegationId    String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([connectionId, createdAt])
  @@index([provider, createdAt])
  @@map("audit_log")
}

// ---------- Capability-scoped delegation (docs/agent-orchestration.md) ----------
// A single-use, time-boxed *permission slip* for one (tool, scope). grantry
// does not execute on its own: it mints this grant and returns a one-time
// grant token; the requesting agent (or a sub-agent using its token) then
// presents the token on a normal tools/call, which grantry gates as usual but
// routes through the target agent's connection. The execution subject stays
// the agent — grantry only manages permission. Owner-bounded: the requesting
// and target agents must share an owner.
model DelegationGrant {
  id              String   @id @default(cuid())
  // The agent allowed to redeem this grant (the requester / bearer).
  requesterAgentId String
  // The capable agent whose connection the redeemed call runs through.
  targetAgentId   String
  tool            String   // canonical, e.g. "railway/graphql"
  scope           String   @default("")
  tokenHash       String   @unique // sha256 of the one-time gn_grant_ token
  status          String   @default("issued") // "issued" | "consumed" | "expired"
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([targetAgentId])
  @@index([requesterAgentId])
  @@map("delegation_grant")
}

// ---------- MCP OAuth (better-auth mcp/oidc-provider plugin) ----------
// These three tables back the OAuth 2.1 authorization server that lets remote
// MCP clients (claude.ai, Claude Desktop, ChatGPT, ...) connect via dynamic
// client registration + PKCE instead of static gn_agt_ tokens.

model OauthApplication {
  id           String   @id @default(cuid())
  name         String
  icon         String?
  metadata     String?
  clientId     String   @unique
  clientSecret String?
  redirectUrls String
  type         String   // "web" | "native" | "user-agent-based" | "public"
  disabled     Boolean  @default(false)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
  @@map("oauth_application")
}

model OauthAccessToken {
  id                    String   @id @default(cuid())
  accessToken           String   @unique
  refreshToken          String   @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  application           OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id           String   @id @default(cuid())
  clientId     String
  application  OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  consentGiven Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// Maps an OAuth grant (user x dynamically-registered client) to the grantry
// Agent it should act as. Resolved on every /mcp request, so changing the
// bound agent's connection grants in the dashboard takes effect immediately.
model OauthAgentGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientId])
  @@index([agentId])
  @@map("oauth_agent_grant")
}

// ---------- Workspaces (docs/workspace-design.md) ----------
// Workspace = management wall (who administers / collaborates).
// Tenant stays the data wall (client boundary) inside a workspace.

model Workspace {
  id          String   @id @default(cuid())
  slug        String   @unique // immutable; rides in connector URLs (/mcp/w/<slug>)
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  directoryLink WorkspaceDirectoryLink?
  agents      Agent[]
  tenants     Tenant[]
  roles       Role[]
  connections Connection[]
  workspaceProviders WorkspaceProvider[]
  providerCredentials ProviderCredential[]
  customProviders CustomProvider[]
  adminApiKeys AdminApiKey[]
  mcpTokens UserMcpToken[]
  knowledge   WorkspaceKnowledge[]
  @@map("workspace")
}

// Company-context rows served by the built-in grantry_company_context tool.
// Data lives in the database per workspace (never in code): this repo is going
// public and the map contents are internal. Rows are imported via the
// workspace AdminApiKey (a daily job upserts by (workspaceId, key)).
model WorkspaceKnowledge {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String // "repo_map" | "rule"
  key         String // stable id so import jobs can upsert
  title       String
  body        String
  // JSON array of qualifier strings ("[]"). Rows are filtered server-side by
  // the calling agent's connection grants (issue #253): a row that requires a
  // permission the caller's connections cannot reach is not returned at all.
  requires    String   @default("[]")
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, key])
  @@index([workspaceId, kind])
  @@map("workspace_knowledge")
}



model WorkspaceMember {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    // "owner" | "admin" | "member"
  createdAt   DateTime  @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String   @default("member")
  token       String   @unique
  invitedById String?
  // Agents to auto-assign once the invite is accepted (JSON array of agent ids)
  agentIds    String   @default("[]")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([email])
  @@map("workspace_invite")
}

// Google Workspace directory link — an application feature, NOT a grantry
// connection. A workspace admin consents once with grantry's own Google
// sign-in client for a read-only directory scope; the tokens live here purely
// to list people for member invites. They are never a Connection, never
// grantable to an agent, and never reachable from MCP.
model WorkspaceDirectoryLink {
  workspaceId           String    @id
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  googleEmail           String // the admin account that consented
  domain                String? // Google `hd` claim, when present
  linkedById            String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  scope                 String    @default("")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("workspace_directory_link")
}

// Person -> agent distribution: which users may connect (via OAuth) as this
// agent. Owners/admins of the agent's workspace are implicitly allowed.
model AgentAssignment {
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([agentId, userId])
  @@index([userId])
  @@map("agent_assignment")
}

// A person's MCP credential within one workspace. A token can reach only the
// assigned agents in this workspace; it is never a cross-workspace credential.
model UserMcpToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable only to allow a safe rollout for the short-lived global-token
  // version. Runtime rejects null rows; newly issued tokens always set it.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label       String
  hashedToken String   @unique
  tokenPrefix String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, workspaceId, revokedAt])
  @@index([workspaceId])
  @@map("user_mcp_token")
}

// Workspace-level provider catalog selection. This controls whether a provider
// appears as a candidate when creating new scope connections. Runtime access is
// still decided by Connection rows and AgentConnectionGrant.
model WorkspaceProvider {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerKey String
  enabled     Boolean  @default(true)
  pinned      Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([workspaceId, providerKey])
  @@index([workspaceId, enabled])
  @@index([createdById])
  @@map("workspace_provider")
}

// Short-lived upload staging. Providers that only accept a file (multipart) or
// a downloadable https URL cannot be reached through the JSON-only MCP
// transport: an agent would have to inline the bytes as base64 in its tool
// call. Instead the agent PUTs the file here once over plain HTTP and then
// references it by id, so bytes never travel through the model's context.
//
// Rows are transient by construction: they carry an expiry, are swept on
// write, and a caller may delete one the moment a provider has consumed it.
model StagedFile {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  filename      String
  contentType   String
  size          Int
  bytes         Bytes
  // sha256 of the download token. The plaintext lives only in the upload
  // response URL, so a leaked database row cannot be turned into a download.
  downloadTokenHash String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastFetchedAt DateTime?
  fetchCount    Int      @default(0)

  @@index([agentId])
  @@index([expiresAt])
  @@map("staged_file")
}

// One-shot permission to upload a staged file as a given agent. An agent that
// reached grantry over OAuth (claude.ai, Claude Desktop) holds no static token
// it could put in a curl command, and minting one for an upload would be a
// permanent credential for a momentary need. It asks for a ticket instead
// (grantry/create_upload_url), uploads to the returned URL, and the ticket
// dies with the upload.
model UploadTicket {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([agentId])
  @@index([expiresAt])
  @@map("upload_ticket")
}
