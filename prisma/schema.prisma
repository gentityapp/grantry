// agent-oauth — Prisma schema
// PostgreSQL (Railway). Replaces the SQLite schema from the Python prototype.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- User auth (better-auth compatible) ----------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user") // "user" | "admin"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  agents        Agent[]
  tenants       Tenant[]
  connections   Connection[]
  roles         Role[]
  auditLogs     AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------- Agent / connection / role (the "agent-oauth" part) ----------

// A tenant is a business/domain boundary owned by one user. `slug` is the
// immutable wire key — it is what agents send as `scope` in tools/call and
// in the X-Grantry-Scope header, so it must never change after creation.
// `displayName` is the human-facing label and can be renamed freely.
model Tenant {
  id          String   @id @default(cuid())
  slug        String   // immutable wire key, e.g. "grantry-dev"
  displayName String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections Connection[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("tenant")
}

model Agent {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  hashedToken   String   // sha256 of the high-entropy agent token (gn_agt_...)
  tokenPrefix   String   // first 12 chars of plaintext (for UI display)
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(true)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles         AgentRole[]
  auditLogs     AuditLog[]

  @@map("agent")
}

model Role {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  allowedTools  String   // ["github/list_repos", "notion/list_dbs", ...]
  allowedScopes String   // ["rootteam", "acme"] — empty array = any scope
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agents        AgentRole[]

  @@map("role")
}

model AgentRole {
  agentId String
  roleId  String
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([agentId, roleId])
  @@map("agent_role")
}

model Connection {
  id                  String   @id @default(cuid())
  provider            String   // "github" | "cloudflare" | "clarity" | "notion" | "google_drive" | "google_gsc" | "google_analytics" | "google_ads" | "yahoo_ads" | "gmail" | "hubspot" | "attio"
  authType            String   @default("pat") // "pat" | "oauth" | "private_app" | "service_account"
  label               String
  scope               String   @default("") // denormalized tenant slug (immutable, always equals tenant.slug); "" = legacy unscoped
  tenantId            String?  // null only for legacy unscoped (scope="") connections
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId             String
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  encryptedCredential String   // Fernet-encrypted PAT/OAuth token
  encryptedServerCredential String? // encrypted provider-level secret, e.g. Google Ads developer token
  credentialMetadata  String   @default("{}") // JSON: observed provider scopes/capabilities, never raw token
  credentialValidatedAt DateTime?
  // OAuth-specific (null for PAT-only providers like notion)
  refreshToken        String?  // also Fernet-encrypted
  accessTokenExpiresAt DateTime?
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([ownerId, provider, scope, authType])
  @@index([provider, scope])
  @@index([ownerId, provider, scope])
  @@index([ownerId])
  @@index([tenantId])
  @@map("connection")
}

// ---------- OAuth state (CSRF protection during OAuth callback) ----------

model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  provider     String
  codeVerifier String?  // for PKCE
  payload      String?  // wizard metadata (tenant, agent, role info)
  redirectTo   String?  // URL to send user after success
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([state])
  @@map("oauth_state")
}

// ---------- Audit log ----------

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?  // null = anonymous (e.g. agent-only call)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentId         String?
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  provider        String   // "github" | "notion" | ...
  tool            String   // "github/list_repos"
  scope           String   @default("")
  status          String   // "ok" | "denied" | "error"
  errorMessage    String?
  requestArgs     String?
  responseSummary String?
  durationMs      Int?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([provider, createdAt])
  @@map("audit_log")
}
