# Database (Railway Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Server
PORT=3000

# Session secret (better-auth)
BETTER_AUTH_SECRET="change-me-32-bytes-of-randomness"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Optional provider-specific Google OAuth overrides.
# If unset, google_gsc / google_analytics / google_ads / gmail fall back to GOOGLE_CLIENT_ID/SECRET.
GOOGLE_GSC_CLIENT_ID=""
GOOGLE_GSC_CLIENT_SECRET=""
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_ANALYTICS_CLIENT_ID=""
GOOGLE_ANALYTICS_CLIENT_SECRET=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_API_VERSION="v22"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/auth/github/callback"

# Notion (uses internal integration tokens, not OAuth)
# Users paste ntn_... or secret_... tokens in the UI

# HubSpot OAuth
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/auth/hubspot/callback"
