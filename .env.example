# Database (Railway Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Server
PORT=3000

# Session secret (better-auth)
BETTER_AUTH_SECRET="change-me-32-bytes-of-randomness"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/auth/github/callback"

# Notion (uses internal integration tokens, not OAuth)
# Users paste ntn_... or secret_... tokens in the UI

# HubSpot OAuth
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/auth/hubspot/callback"
