# Database (Railway Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Server
PORT=3000

# Agent-facing MCP host, kept separate from the dashboard/OAuth host so the MCP
# URL never moves. When set, connector configs and curl snippets in the
# dashboard advertise this origin for /mcp (e.g. https://api.grantry.ai).
# Leave unset for local dev / single-host setups to fall back to the dashboard
# origin (PUBLIC_BASE_URL / BETTER_AUTH_URL / request host).
MCP_PUBLIC_BASE_URL="https://api.grantry.ai"

# Session secret (better-auth)
BETTER_AUTH_SECRET="change-me-32-bytes-of-randomness"

# Google sign-in OAuth for the dashboard login button. Keep this separate from
# connector OAuth clients so provider connection scopes can rotate independently.
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Shared Google connector OAuth fallback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Optional provider-specific Google OAuth overrides.
# If unset, google_gsc / google_analytics / google_ads / gmail / youtube fall back to GOOGLE_CLIENT_ID/SECRET.
GOOGLE_GSC_CLIENT_ID=""
GOOGLE_GSC_CLIENT_SECRET=""
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_ANALYTICS_CLIENT_ID=""
GOOGLE_ANALYTICS_CLIENT_SECRET=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_API_VERSION="v22"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/auth/github/callback"

# Notion (uses internal integration tokens, not OAuth)
# Users paste ntn_... or secret_... tokens in the UI

# HubSpot OAuth
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/auth/hubspot/callback"

# Slack OAuth (optional — Slack can also be connected by pasting a Bot User
# OAuth Token). Register the redirect URL <origin>/oauth/slack/callback in the
# Slack app's OAuth & Permissions page.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# freee OAuth (会計freee)
# Register an app at https://app.secure.freee.co.jp/developers/applications
# Callback URL: <BETTER_AUTH_URL>/oauth/freee/callback
FREEE_CLIENT_ID=""
FREEE_CLIENT_SECRET=""

# Meta (Facebook) Marketing API OAuth
# Register a Meta app with the Marketing API at https://developers.facebook.com/apps
META_ADS_CLIENT_ID=""
META_ADS_CLIENT_SECRET=""
META_ADS_API_VERSION="v21.0"

# Reddit OAuth (register a "web app" at reddit.com/prefs/apps)
# Redirect URI: <BETTER_AUTH_URL>/oauth/reddit/callback
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# X (Twitter) OAuth 2.0 (Confidential client / Web App in the X developer portal)
# Callback URI: <BETTER_AUTH_URL>/oauth/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""
