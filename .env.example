# Database (Railway Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Server
PORT=3000

# Public origins. Optional; leave unset for local dev / single-host setups to
# fall back to the request host (or BETTER_AUTH_URL when set).
# PUBLIC_BASE_URL: canonical dashboard URL used in generated links.
# PUBLIC_DASHBOARD_ORIGIN: dashboard origin in the OpenAPI docs
#   (default: https://app.grantry.ai).
# PUBLIC_MCP_ORIGIN: MCP origin in the OpenAPI docs and file links
#   (default: https://api.grantry.ai).
PUBLIC_BASE_URL=""
PUBLIC_DASHBOARD_ORIGIN=""
PUBLIC_MCP_ORIGIN=""

# Dashboard base URL (better-auth). Required in production: OAuth callbacks,
# password-reset links and admin tools use it as the canonical origin.
# Falls back to APP_ORIGIN, then http://localhost:3000.
BETTER_AUTH_URL=""
# Legacy alias for the dashboard origin, used by admin tools when
# BETTER_AUTH_URL is unset. Optional.
APP_ORIGIN=""
# Comma-separated extra origins trusted by better-auth (e.g. a legacy domain
# that still serves the dashboard while BETTER_AUTH_URL is canonical). Optional.
TRUSTED_ORIGINS=""

# Agent-facing MCP host, kept separate from the dashboard/OAuth host so the MCP
# URL never moves. When set, connector configs and curl snippets in the
# dashboard advertise this origin for /mcp (e.g. https://api.grantry.ai).
# Leave unset for local dev / single-host setups to fall back to the dashboard
# origin (PUBLIC_BASE_URL / BETTER_AUTH_URL / request host).
MCP_PUBLIC_BASE_URL="https://api.grantry.ai"

# Per-token request budget per minute at POST /mcp. Optional, default 120.
MCP_RATE_LIMIT_PER_MINUTE="120"

# Session secret (better-auth)
BETTER_AUTH_SECRET="change-me-32-bytes-of-randomness"

# Credential encryption key (AES-256-GCM). Required: connector credentials at
# rest are encrypted with it, and startup fails without it. Keep it separate
# from BETTER_AUTH_SECRET so the session-signing key never doubles as the
# credential key.
FERNET_KEY=""

# Google sign-in OAuth for the dashboard login button. Keep this separate from
# connector OAuth clients so provider connection scopes can rotate independently.
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Legacy aliases for the Google sign-in OAuth client above, used when
# AUTH_GOOGLE_CLIENT_ID/SECRET are unset. Optional.
GRANTRY_AUTH_GOOGLE_CLIENT_ID=""
GRANTRY_AUTH_GOOGLE_CLIENT_SECRET=""

# Shared Google connector OAuth fallback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Optional provider-specific Google OAuth overrides.
# If unset, google_gsc / google_analytics / google_ads / gmail / youtube fall back to GOOGLE_CLIENT_ID/SECRET.
GOOGLE_GSC_CLIENT_ID=""
GOOGLE_GSC_CLIENT_SECRET=""
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_ANALYTICS_CLIENT_ID=""
GOOGLE_ANALYTICS_CLIENT_SECRET=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_API_VERSION="v22"

# Other connector API versions. Optional; each falls back to the version shown.
# MESSENGER_API_VERSION falls back to META_ADS_API_VERSION first, then v21.0.
MESSENGER_API_VERSION=""
YAHOO_ADS_API_VERSION="v17"

# Operations
# Domain treated as the operator's own in the admin dashboard. Optional.
OPS_DOMAIN=""
# Set to 1 to disable the periodic connector health sweep. Optional.
HEALTH_SWEEP_DISABLED=""

# System email (password reset etc.), sent via Resend. Optional: without a key,
# emails are logged to the server console instead of being sent.
# SYSTEM_EMAIL_FROM default: grantry <noreply@app.grantry.ai>
RESEND_API_KEY=""
SYSTEM_EMAIL_FROM=""

# Public seminar-survey form -> CRM pipeline. Optional: without these the form
# endpoints return an error instead of writing to the CRM.
# SEMINAR_FORM_MCP_URL: MCP URL the form handler calls
#   (default: http://127.0.0.1:<PORT>/mcp).
# SEMINAR_FORM_AGENT_TOKEN: agent token (gn_agt_...) for that MCP call.
# SEMINAR_FORM_TWENTY_SCOPE: CRM scope the created records use (default: gtm).
SEMINAR_FORM_MCP_URL=""
SEMINAR_FORM_AGENT_TOKEN=""
SEMINAR_FORM_TWENTY_SCOPE=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/auth/github/callback"

# Notion (uses internal integration tokens, not OAuth)
# Users paste ntn_... or secret_... tokens in the UI

# HubSpot OAuth
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/auth/hubspot/callback"

# Slack OAuth (optional — Slack can also be connected by pasting a Bot User
# OAuth Token). Register the redirect URL <origin>/oauth/slack/callback in the
# Slack app's OAuth & Permissions page.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# freee OAuth (会計freee)
# Register an app at https://app.secure.freee.co.jp/developers/applications
# Callback URL: <BETTER_AUTH_URL>/oauth/freee/callback
FREEE_CLIENT_ID=""
FREEE_CLIENT_SECRET=""

# Meta (Facebook) Marketing API OAuth
# Register a Meta app with the Marketing API at https://developers.facebook.com/apps
META_ADS_CLIENT_ID=""
META_ADS_CLIENT_SECRET=""
META_ADS_API_VERSION="v21.0"

# Reddit OAuth (register a "web app" at reddit.com/prefs/apps)
# Redirect URI: <BETTER_AUTH_URL>/oauth/reddit/callback
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# X (Twitter) OAuth 2.0 (Confidential client / Web App in the X developer portal)
# Callback URI: <BETTER_AUTH_URL>/oauth/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""
